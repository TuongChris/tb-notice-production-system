  parentBinding          CorrespondenceBinding?  @relation("R_PromptSnapshot_parentBinding", fields: [parentBindingId, caseId], references: [id, caseId], onDelete: Restrict, onUpdate: Restrict, map: "fk_prompt_snapshots_parent_binding")
  noticeCandidate_prompt NoticeCandidate[]       @relation("R_NoticeCandidate_prompt")

  @@unique([caseId, taskType, version], map: "prompt_snapshots_case_id_task_type_version_key")
  @@unique([id, caseId], map: "prompt_snapshots_id_case_id_key")
  @@index([caseId, createdAt], map: "prompt_snapshots_case_id_created_at_idx")
  @@map("prompt_snapshots")
}

/// Content immutable at insert. PATCH body is forbidden. Only supersededAt/reason may be set by dedicated command. Artifact hash binds body, subject, envelope, planned documents and signature slot; does not prove send.
model NoticeCandidate {
  id                              String                @id @default(uuid()) @map("id") @db.Char(36)
  caseId                          String                @map("case_id") @db.Char(36)
  promptSnapshotId                String                @map("prompt_snapshot_id") @db.Char(36)
  parentCandidateId               String?               @map("parent_candidate_id") @db.Char(36)
  version                         Int                   @map("version") @db.UnsignedInt
  taskType                        TaskType              @map("task_type")
  subject                         String                @map("subject") @db.VarChar(998)
  envelopeJson                    Json                  @map("envelope_json")
  bodyText                        String                @map("body_text") @db.LongText
  bodySha256                      String                @map("body_sha256") @db.VarChar(64)
  artifactSha256                  String                @map("artifact_sha256") @db.VarChar(64)
  preparedDocuments               Json                  @map("prepared_documents")
  signatureState                  String                @default("HUMAN_PENDING") @map("signature_state") @db.VarChar(40)
  authoringTool                   String?               @map("authoring_tool") @db.VarChar(100)
  revisionReason                  String?               @map("revision_reason") @db.LongText
  supersededAt                    DateTime?             @map("superseded_at") @db.DateTime(3)
  supersedeReason                 String?               @map("supersede_reason") @db.LongText
  createdAt                       DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  createdById                     String                @map("created_by_id") @db.Char(36)
  createdBy                       User                  @relation("R_NoticeCandidate_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notice_candidates_created_by")
  caseRecord                      CaseRecord            @relation("R_NoticeCandidate_caseRecord", fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notice_candidates_case_record")
  prompt                          PromptSnapshot        @relation("R_NoticeCandidate_prompt", fields: [promptSnapshotId, caseId], references: [id, caseId], onDelete: Restrict, onUpdate: Restrict, map: "fk_notice_candidates_prompt")
  parentCandidate                 NoticeCandidate?      @relation("R_NoticeCandidate_parentCandidate", fields: [parentCandidateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notice_candidates_parent_candidate")
  noticeCandidate_parentCandidate NoticeCandidate[]     @relation("R_NoticeCandidate_parentCandidate")
  validationRun_candidate         ValidationRun[]       @relation("R_ValidationRun_candidate")
  candidateAssessment_candidate   CandidateAssessment[] @relation("R_CandidateAssessment_candidate")

  @@unique([caseId, taskType, version], map: "notice_candidates_case_id_task_type_version_key")
  @@unique([id, caseId], map: "notice_candidates_id_case_id_key")
  @@index([caseId, createdAt], map: "notice_candidates_case_id_created_at_idx")
  @@map("notice_candidates")
}

/// Server-generated structural/heuristic checks only. Never implies G1-G6 were reviewed substantively.
model ValidationRun {
  id                   String            @id @default(uuid()) @map("id") @db.Char(36)
  candidateId          String            @map("candidate_id") @db.Char(36)
  caseId               String            @map("case_id") @db.Char(36)
  artifactSha256       String            @map("artifact_sha256") @db.VarChar(64)
  dependencyDigest     String            @map("dependency_digest") @db.VarChar(64)
  dependencyManifest   Json              @map("dependency_manifest")
  evaluatedContextJson Json              @map("evaluated_context_json")
  rulesetVersion       String            @map("ruleset_version") @db.VarChar(80)
  result               TechnicalResult   @map("result")
  coverageManifest     Json              @map("coverage_manifest")
  blockerCount         Int               @map("blocker_count") @db.UnsignedInt
  reviewRequiredCount  Int               @map("review_required_count") @db.UnsignedInt
  warningCount         Int               @map("warning_count") @db.UnsignedInt
  startedAt            DateTime          @map("started_at") @db.DateTime(3)
  completedAt          DateTime          @map("completed_at") @db.DateTime(3)
  createdAt            DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  createdById          String            @map("created_by_id") @db.Char(36)
  createdBy            User              @relation("R_ValidationRun_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_validation_runs_created_by")
  candidate            NoticeCandidate   @relation("R_ValidationRun_candidate", fields: [candidateId, caseId], references: [id, caseId], onDelete: Restrict, onUpdate: Restrict, map: "fk_validation_runs_candidate")
  validationIssue_run  ValidationIssue[] @relation("R_ValidationIssue_run")

  @@unique([id, candidateId], map: "validation_runs_id_candidate_id_key")
  @@index([candidateId, createdAt], map: "validation_runs_candidate_id_created_at_idx")
  @@map("validation_runs")
}

/// 
model ValidationIssue {
  id          String        @id @default(uuid()) @map("id") @db.Char(36)
  runId       String        @map("run_id") @db.Char(36)
  ruleId      String        @map("rule_id") @db.VarChar(100)
  checkKind   CheckKind     @map("check_kind")
  severity    IssueSeverity @map("severity")
  fieldPath   String?       @map("field_path") @db.VarChar(500)
  message     String        @map("message") @db.LongText
  details     Json?         @map("details")
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  createdById String        @map("created_by_id") @db.Char(36)
  createdBy   User          @relation("R_ValidationIssue_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_validation_issues_created_by")
  run         ValidationRun @relation("R_ValidationIssue_run", fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_validation_issues_run")

  @@index([runId, severity], map: "validation_issues_run_id_severity_idx")
  @@map("validation_issues")
}

/// Attributable source-bound G1-G6 review capture, not an automatic decision and never G7. Source inclusion alone cannot verify legal facts. POST is an operator report of an actual assessment, not a request for fabricated PASS.
model CandidateAssessment {
  id                                       String               @id @default(uuid()) @map("id") @db.Char(36)
  candidateId                              String               @map("candidate_id") @db.Char(36)
  caseId                                   String               @map("case_id") @db.Char(36)
  gate                                     GateId               @map("gate")
  result                                   GateResult           @map("result")
  artifactSha256                           String               @map("artifact_sha256") @db.VarChar(64)
  dependencyDigest                         String               @map("dependency_digest") @db.VarChar(64)
  rulesetVersion                           String               @map("ruleset_version") @db.VarChar(80)
  scopeState                               AssessmentScopeState @default(RECORDED_NOT_ADOPTED) @map("scope_state")
  performerKind                            PerformerKind        @map("performer_kind")
  performerLabel                           String               @map("performer_label") @db.VarChar(255)
  assessedAt                               DateTime?            @map("assessed_at") @db.DateTime(3)
  provenance                               Provenance           @map("provenance")
  rationale                                String               @map("rationale") @db.LongText
  scopeText                                String               @map("scope_text") @db.LongText
  limitations                              String?              @map("limitations") @db.LongText
  askDispositions                          Json?                @map("ask_dispositions")
  supersedesAssessmentId                   String?              @unique @map("supersedes_assessment_id") @db.Char(36)
  createdAt                                DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  createdById                              String               @map("created_by_id") @db.Char(36)
  createdBy                                User                 @relation("R_CandidateAssessment_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_candidate_assessments_created_by")
  candidate                                NoticeCandidate      @relation("R_CandidateAssessment_candidate", fields: [candidateId, caseId], references: [id, caseId], onDelete: Restrict, onUpdate: Restrict, map: "fk_candidate_assessments_candidate")
  supersedesAssessment                     CandidateAssessment? @relation("R_CandidateAssessment_supersedesAssessment", fields: [supersedesAssessmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_candidate_assessments_supersedes_assessment")
  candidateAssessment_supersedesAssessment CandidateAssessment? @relation("R_CandidateAssessment_supersedesAssessment")
  assessmentSource_assessment              AssessmentSource[]   @relation("R_AssessmentSource_assessment")

  @@index([candidateId, gate, createdAt], map: "candidate_assessments_candidate_id_gate_created_at_idx")
  @@map("candidate_assessments")
}

/// Backend checks the case and scope of both endpoints.
model AssessmentSource {
  id                  String              @id @default(uuid()) @map("id") @db.Char(36)
  assessmentId        String              @map("assessment_id") @db.Char(36)
  caseSourceId        String              @map("case_source_id") @db.Char(36)
  supportedConclusion String              @map("supported_conclusion") @db.LongText
  createdAt           DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  createdById         String              @map("created_by_id") @db.Char(36)
  createdBy           User                @relation("R_AssessmentSource_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assessment_sources_created_by")
  assessment          CandidateAssessment @relation("R_AssessmentSource_assessment", fields: [assessmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assessment_sources_assessment")
  caseSource          CaseSource          @relation("R_AssessmentSource_caseSource", fields: [caseSourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assessment_sources_case_source")

  @@unique([assessmentId, caseSourceId], map: "assessment_sources_assessment_id_case_source_id_key")
  @@map("assessment_sources")
}

/// Append-only application audit, not tamper-proof evidence. Passwords, session tokens and raw confidential bodies excluded.
model AuditEvent {
  id             String   @id @default(uuid()) @map("id") @db.Char(36)
  actorUserId    String?  @map("actor_user_id") @db.Char(36)
  requestId      String   @map("request_id") @db.VarChar(100)
  action         String   @map("action") @db.VarChar(120)
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String?  @map("entity_id") @db.Char(36)
  beforeRedacted Json?    @map("before_redacted")
  afterRedacted  Json?    @map("after_redacted")
  reason         String?  @map("reason") @db.LongText
  sourceIds      Json?    @map("source_ids")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  actor          User?    @relation("R_AuditEvent_actor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_events_actor")

  @@index([entityType, entityId, createdAt, id], map: "audit_events_entity_type_entity_id_created_at_id_idx")
  @@index([actorUserId, createdAt], map: "audit_events_actor_user_id_created_at_idx")
  @@map("audit_events")
}

/// Same actor + operation + key + payload replays same response; failed tx leaves no committed result. Expiry is bounded replay horizon, not permanent deduplication.
model IdempotencyRecord {
  id             String           @id @default(uuid()) @map("id") @db.Char(36)
  actorUserId    String           @map("actor_user_id") @db.Char(36)
  operationId    String           @map("operation_id") @db.VarChar(100)
  idempotencyKey String           @map("idempotency_key") @db.VarChar(100)
  requestSha256  String           @map("request_sha256") @db.VarChar(64)
  state          IdempotencyState @map("state")
  responseStatus Int?             @map("response_status") @db.UnsignedSmallInt
  responseJson   Json?            @map("response_json")
  resourceType   String?          @map("resource_type") @db.VarChar(100)
  resourceId     String?          @map("resource_id") @db.Char(36)
  expiresAt      DateTime         @map("expires_at") @db.DateTime(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  actor          User             @relation("R_IdempotencyRecord_actor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_idempotency_records_actor")

  @@unique([actorUserId, operationId, idempotencyKey], map: "idempotency_records_actor_user_id_operation_id_i_92ad1804")
  @@index([expiresAt], map: "idempotency_records_expires_at_idx")
  @@map("idempotency_records")
}
