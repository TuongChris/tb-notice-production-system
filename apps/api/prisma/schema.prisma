// TB-SCHEMA-API-v1.0.0 — proposed implementation schema. NOT migrated.
// Read docs/DATABASE_SCHEMA_v1.md and docs/INVARIANTS.md before implementation.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "foreignKeys"
}

enum BindingState {
  LOCAL_ONLY
  SOURCE_REFERENCED
  DIVERGENT
}

enum RecordState {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SubjectType {
  INDIVIDUAL
  LEGAL_ENTITY
  OTHER
}

enum Platform {
  YOUTUBE
}

enum LinkState {
  LINKED
  PAUSED
  UNLINKED
}

enum SignerState {
  DRAFT
  AVAILABLE
  PAUSED
  ENDED
}

enum VersionState {
  DRAFT
  FROZEN
}

enum ChangeKind {
  NEW_AUTHORIZATION
  AMENDMENT
  DOCUMENT_CAPTURE
  METADATA_CORRECTION
}

enum ValidityModel {
  UNKNOWN
  FIXED_TERM
  UNTIL_TERMINATED
}

enum DocumentState {
  MISSING
  DRAFT
  SIGNED_APPEARING
  UNKNOWN
}

enum ReviewState {
  UNREVIEWED
  REVIEWED_WITH_LIMITS
  CONFLICT
}

enum CoverageState {
  PROPOSED
  RECORDED
  SUSPENDED
  ENDED
}

enum Exclusivity {
  UNKNOWN
  EXCLUSIVE
  NON_EXCLUSIVE
}

enum AuthorityEventType {
  CURRENTNESS_RECORDED
  REVOCATION
  TERMINATION
  SUPERSESSION
  RESIGNATION
  CORRECTION
}

enum Provenance {
  DOCUMENT_REVIEWED
  OPERATOR_REPORTED
  ANALYSIS
  MISSING
  CONFLICT
}

enum CaseClass {
  WORKING_INTAKE
  CURRENT_OPERATION
  RECOVERED_HISTORY
  EXTERNAL_REFERENCE
}

enum WorkflowState {
  INTAKE
  PREPARING
  DRAFTING
  AWAITING_HUMAN
  AWAITING_PLATFORM
  CLOSED
}

enum TaskType {
  INITIAL
  NMI_REPLY
}

enum GenerationMode {
  PREPARATION
  DRAFTING
}

enum SourceRole {
  CANONICAL_RECORD
  PRIMARY_CORRESPONDENCE
  OPERATOR_INPUT
  DERIVED_DRAFT
  EXTERNAL_REFERENCE
  POLICY_REFERENCE
}

enum AccessState {
  NOT_CHECKED
  ACCESSIBLE_AT_CHECK
  UNAVAILABLE_AT_CHECK
}

enum HashTarget {
  RAW_FILE
  EXTRACTED_TEXT
  OTHER
}

enum FactType {
  RIGHTS_BASIS
  RIGHTS_SCOPE
  PERMISSION
  AV_COMPARISON
  EXCEPTION_REVIEW
  WORK_IDENTIFICATION
  REPORTED_IDENTIFICATION
  DUPLICATE_REVIEW
  AUTHORITY_CURRENTNESS
}

enum FactScope {
  CASE
  WORK
  REPORTED_ITEM
  USE
}

enum ResolutionState {
  UNASSESSED
  SUPPORTED_FOR_SCOPE
  CONFLICT
  WITHDRAWN
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum CaptureMode {
  RAW_SOURCE
  COPIED_FULL_TEXT
  EXCERPT
  OPERATOR_REPORTED
}

enum BodyRole {
  FULL_MESSAGE
  AUTHORED_BODY
  QUOTED_HISTORY
  EXCERPT
  UNKNOWN
}

enum EventType {
  INITIAL_AS_SENT
  ACK
  NMI
  REPLY_AS_SENT
  SUPPLEMENT_AS_SENT
  CORRECTION_AS_SENT
  OUTCOME
  OTHER
}

enum Outcome {
  REMOVED
  REINSTATED
  REJECTED
  RETRACTED
  OTHER
}

enum TechnicalResult {
  TECHNICAL_PASS
  BLOCKED
  REVIEW_REQUIRED
  ERROR
}

enum IssueSeverity {
  BLOCKER
  REVIEW_REQUIRED
  WARNING
  INFO
}

enum CheckKind {
  DETERMINISTIC
  HEURISTIC
}

enum GateId {
  G1
  G2
  G3
  G4
  G5
  G6
}

enum GateResult {
  PASS
  HOLD
  BLOCKED
  MISSING
  CONFLICT
}

enum PerformerKind {
  HUMAN
  AI_ASSISTED
  DOCUMENTED_EXTERNAL_REVIEW
}

enum AssessmentScopeState {
  RECORDED_NOT_ADOPTED
  SCOPE_CONFIRMED_FOR_CANDIDATE
}

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED
}

/// App operator, never automatically a signer. Bootstrap via local CLI, no public user creation API.
model User {
  id                               String                   @id @default(uuid()) @map("id") @db.Char(36)
  email                            String                   @unique @map("email") @db.VarChar(254)
  displayName                      String                   @map("display_name") @db.VarChar(160)
  passwordHash                     String                   @map("password_hash") @db.VarChar(255)
  enabled                          Boolean                  @default(true) @map("enabled")
  sessionEpoch                     Int                      @default(1) @map("session_epoch") @db.UnsignedInt
  passwordChangedAt                DateTime?                @map("password_changed_at") @db.DateTime(3)
  disabledAt                       DateTime?                @map("disabled_at") @db.DateTime(3)
  createdAt                        DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  authSession_user                 AuthSession[]            @relation("R_AuthSession_user")
  agency_createdBy                 Agency[]                 @relation("R_Agency_createdBy")
  agency_updatedBy                 Agency[]                 @relation("R_Agency_updatedBy")
  owner_createdBy                  Owner[]                  @relation("R_Owner_createdBy")
  owner_updatedBy                  Owner[]                  @relation("R_Owner_updatedBy")
  legalSubject_createdBy           LegalSubject[]           @relation("R_LegalSubject_createdBy")
  legalSubject_updatedBy           LegalSubject[]           @relation("R_LegalSubject_updatedBy")
  ownerSubject_createdBy           OwnerSubject[]           @relation("R_OwnerSubject_createdBy")
  ownerSubject_updatedBy           OwnerSubject[]           @relation("R_OwnerSubject_updatedBy")
  signer_createdBy                 Signer[]                 @relation("R_Signer_createdBy")
  signer_updatedBy                 Signer[]                 @relation("R_Signer_updatedBy")
  route_createdBy                  Route[]                  @relation("R_Route_createdBy")
  route_updatedBy                  Route[]                  @relation("R_Route_updatedBy")
  mandate_createdBy                Mandate[]                @relation("R_Mandate_createdBy")
  mandate_updatedBy                Mandate[]                @relation("R_Mandate_updatedBy")
  mandateVersion_createdBy         MandateVersion[]         @relation("R_MandateVersion_createdBy")
  mandateVersion_updatedBy         MandateVersion[]         @relation("R_MandateVersion_updatedBy")
  mandateCoverage_createdBy        MandateCoverage[]        @relation("R_MandateCoverage_createdBy")
  mandateCoverage_updatedBy        MandateCoverage[]        @relation("R_MandateCoverage_updatedBy")
  coverageSigner_createdBy         CoverageSigner[]         @relation("R_CoverageSigner_createdBy")
  coverageSigner_updatedBy         CoverageSigner[]         @relation("R_CoverageSigner_updatedBy")
  authorityEvent_createdBy         AuthorityEvent[]         @relation("R_AuthorityEvent_createdBy")
  caseRecord_createdBy             CaseRecord[]             @relation("R_CaseRecord_createdBy")
  caseRecord_updatedBy             CaseRecord[]             @relation("R_CaseRecord_updatedBy")
  caseAuthoritySelection_createdBy CaseAuthoritySelection[] @relation("R_CaseAuthoritySelection_createdBy")
  caseAuthorityCoverage_createdBy  CaseAuthorityCoverage[]  @relation("R_CaseAuthorityCoverage_createdBy")
  reportedItem_createdBy           ReportedItem[]           @relation("R_ReportedItem_createdBy")
  reportedItem_updatedBy           ReportedItem[]           @relation("R_ReportedItem_updatedBy")
  caseWork_createdBy               CaseWork[]               @relation("R_CaseWork_createdBy")
  caseWork_updatedBy               CaseWork[]               @relation("R_CaseWork_updatedBy")
  useMapping_createdBy             UseMapping[]             @relation("R_UseMapping_createdBy")
  useMapping_updatedBy             UseMapping[]             @relation("R_UseMapping_updatedBy")
  sourceReference_createdBy        SourceReference[]        @relation("R_SourceReference_createdBy")
  caseSource_createdBy             CaseSource[]             @relation("R_CaseSource_createdBy")
  caseSource_updatedBy             CaseSource[]             @relation("R_CaseSource_updatedBy")
  caseFact_createdBy               CaseFact[]               @relation("R_CaseFact_createdBy")
  factSource_createdBy             FactSource[]             @relation("R_FactSource_createdBy")
  correspondence_createdBy         Correspondence[]         @relation("R_Correspondence_createdBy")
  correspondenceBinding_createdBy  CorrespondenceBinding[]  @relation("R_CorrespondenceBinding_createdBy")
  promptSnapshot_createdBy         PromptSnapshot[]         @relation("R_PromptSnapshot_createdBy")
  noticeCandidate_createdBy        NoticeCandidate[]        @relation("R_NoticeCandidate_createdBy")
  validationRun_createdBy          ValidationRun[]          @relation("R_ValidationRun_createdBy")
  validationIssue_createdBy        ValidationIssue[]        @relation("R_ValidationIssue_createdBy")
  candidateAssessment_createdBy    CandidateAssessment[]    @relation("R_CandidateAssessment_createdBy")
  assessmentSource_createdBy       AssessmentSource[]       @relation("R_AssessmentSource_createdBy")
  auditEvent_actor                 AuditEvent[]             @relation("R_AuditEvent_actor")
  idempotencyRecord_actor          IdempotencyRecord[]      @relation("R_IdempotencyRecord_actor")

  @@map("users")
}

/// Store only hashes, never raw browser tokens.
model AuthSession {
  id            String    @id @default(uuid()) @map("id") @db.Char(36)
  userId        String    @map("user_id") @db.Char(36)
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  csrfTokenHash String    @map("csrf_token_hash") @db.VarChar(64)
  expiresAt     DateTime  @map("expires_at") @db.DateTime(3)
  lastSeenAt    DateTime  @map("last_seen_at") @db.DateTime(3)
  revokedAt     DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user          User      @relation("R_AuthSession_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_auth_sessions_user")

  @@index([userId, expiresAt], map: "auth_sessions_user_id_expires_at_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

/// Directory/configuration state is not legal authority. fieldAttributions has schema and source checks in service.
model Agency {
  id                     String            @id @default(uuid()) @map("id") @db.Char(36)
  displayName            String            @map("display_name") @db.VarChar(200)
  legalName              String?           @map("legal_name") @db.VarChar(255)
  organizationType       String?           @map("organization_type") @db.VarChar(50)
  jurisdictionCountry    String?           @map("jurisdiction_country") @db.VarChar(2)
  registrationAuthority  String?           @map("registration_authority") @db.VarChar(200)
  registrationNumber     String?           @map("registration_number") @db.VarChar(100)
  websiteUrl             String?           @map("website_url") @db.VarChar(2048)
  copyrightEmail         String?           @map("copyright_email") @db.VarChar(254)
  verificationEmail      String?           @map("verification_email") @db.VarChar(254)
  postalAddress          Json?             @map("postal_address")
  phone                  String?           @map("phone") @db.VarChar(80)
  driveRootUrl           String?           @map("drive_root_url") @db.VarChar(2048)
  masterUrl              String?           @map("master_url") @db.VarChar(2048)
  startHereUrl           String?           @map("start_here_url") @db.VarChar(2048)
  fieldAttributions      Json?             @map("field_attributions")
  recordState            RecordState       @default(DRAFT) @map("record_state")
  canonicalCode          String?           @unique @map("canonical_code") @db.VarChar(100)
  canonicalSourceId      String?           @map("canonical_source_id") @db.Char(36)
  bindingState           BindingState      @default(LOCAL_ONLY) @map("binding_state")
  notes                  String?           @map("notes") @db.LongText
  archivedAt             DateTime?         @map("archived_at") @db.DateTime(3)
  archiveReason          String?           @map("archive_reason") @db.LongText
  createdAt              DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  createdById            String            @map("created_by_id") @db.Char(36)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  updatedById            String            @map("updated_by_id") @db.Char(36)
  rowVersion             Int               @default(1) @map("row_version") @db.UnsignedInt
  createdBy              User              @relation("R_Agency_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_agencies_created_by")
  updatedBy              User              @relation("R_Agency_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_agencies_updated_by")
  canonicalSource        SourceReference?  @relation("R_Agency_canonicalSource", fields: [canonicalSourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_agencies_canonical_source")
  signer_agency          Signer[]          @relation("R_Signer_agency")
  route_agency           Route[]           @relation("R_Route_agency")
  mandate_agency         Mandate[]         @relation("R_Mandate_agency")
  caseRecord_agency      CaseRecord[]      @relation("R_CaseRecord_agency")
  sourceReference_agency SourceReference[] @relation("R_SourceReference_agency")
  correspondence_agency  Correspondence[]  @relation("R_Correspondence_agency")

  @@index([recordState, createdAt], map: "agencies_record_state_created_at_idx")
  @@map("agencies")
}

/// Client namespace, not proof of work ownership.
model Owner {
  id                   String           @id @default(uuid()) @map("id") @db.Char(36)
  displayName          String           @map("display_name") @db.VarChar(200)
  aliases              Json?            @map("aliases")
  contactName          String?          @map("contact_name") @db.VarChar(200)
  contactEmail         String?          @map("contact_email") @db.VarChar(254)
  sourceChannels       Json?            @map("source_channels")
  websiteUrl           String?          @map("website_url") @db.VarChar(2048)
  preferredLanguage    String?          @map("preferred_language") @db.VarChar(20)
  driveFolderUrl       String?          @map("drive_folder_url") @db.VarChar(2048)
  recordState          RecordState      @default(DRAFT) @map("record_state")
  canonicalCode        String?          @unique @map("canonical_code") @db.VarChar(100)
  canonicalSourceId    String?          @map("canonical_source_id") @db.Char(36)
  bindingState         BindingState     @default(LOCAL_ONLY) @map("binding_state")
  notes                String?          @map("notes") @db.LongText
  archivedAt           DateTime?        @map("archived_at") @db.DateTime(3)
  archiveReason        String?          @map("archive_reason") @db.LongText
  createdAt            DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  createdById          String           @map("created_by_id") @db.Char(36)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  updatedById          String           @map("updated_by_id") @db.Char(36)
  rowVersion           Int              @default(1) @map("row_version") @db.UnsignedInt
  createdBy            User             @relation("R_Owner_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_owners_created_by")
  updatedBy            User             @relation("R_Owner_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_owners_updated_by")
  canonicalSource      SourceReference? @relation("R_Owner_canonicalSource", fields: [canonicalSourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_owners_canonical_source")
  ownerSubject_owner   OwnerSubject[]   @relation("R_OwnerSubject_owner")
  caseRecord_ownerHint CaseRecord[]     @relation("R_CaseRecord_ownerHint")

  @@index([recordState, createdAt], map: "owners_record_state_created_at_idx")
  @@map("owners")
}

/// Exact person or legal entity. Names/registration are matching hints, not automatic global deduplication.
model LegalSubject {
  id                        String           @id @default(uuid()) @map("id") @db.Char(36)
  subjectType               SubjectType      @map("subject_type")
  legalName                 String           @map("legal_name") @db.VarChar(255)
  aliases                   Json?            @map("aliases")
  jurisdictionCountry       String?          @map("jurisdiction_country") @db.VarChar(2)
  legalForm                 String?          @map("legal_form") @db.VarChar(80)
  registrationAuthority     String?          @map("registration_authority") @db.VarChar(200)
  registrationNumber        String?          @map("registration_number") @db.VarChar(100)
  contactEmail              String?          @map("contact_email") @db.VarChar(254)
  postalAddress             Json?            @map("postal_address")
  fieldAttributions         Json?            @map("field_attributions")
  identityReviewState       ReviewState      @default(UNREVIEWED) @map("identity_review_state")
  recordState               RecordState      @default(DRAFT) @map("record_state")
  canonicalCode             String?          @unique @map("canonical_code") @db.VarChar(100)
  canonicalSourceId         String?          @map("canonical_source_id") @db.Char(36)
  bindingState              BindingState     @default(LOCAL_ONLY) @map("binding_state")
  notes                     String?          @map("notes") @db.LongText
  archivedAt                DateTime?        @map("archived_at") @db.DateTime(3)
  archiveReason             String?          @map("archive_reason") @db.LongText
  createdAt                 DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  createdById               String           @map("created_by_id") @db.Char(36)
  updatedAt                 DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  updatedById               String           @map("updated_by_id") @db.Char(36)
  rowVersion                Int              @default(1) @map("row_version") @db.UnsignedInt
  createdBy                 User             @relation("R_LegalSubject_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_legal_subjects_created_by")
  updatedBy                 User             @relation("R_LegalSubject_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_legal_subjects_updated_by")
  canonicalSource           SourceReference? @relation("R_LegalSubject_canonicalSource", fields: [canonicalSourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_legal_subjects_canonical_source")
  ownerSubject_legalSubject OwnerSubject[]   @relation("R_OwnerSubject_legalSubject")

  @@index([legalName], map: "legal_subjects_legal_name_idx")
  @@index([registrationAuthority, registrationNumber], map: "legal_subjects_registration_authority_registrati_902c1ede")
  @@map("legal_subjects")
}

/// 
model OwnerSubject {
  id                 String           @id @default(uuid()) @map("id") @db.Char(36)
  ownerId            String           @map("owner_id") @db.Char(36)
  legalSubjectId     String           @map("legal_subject_id") @db.Char(36)
  relationshipLabel  String?          @map("relationship_label") @db.VarChar(200)
  sourceId           String?          @map("source_id") @db.Char(36)
  linkState          LinkState        @default(LINKED) @map("link_state")
  unlinkedAt         DateTime?        @map("unlinked_at") @db.DateTime(3)
  unlinkReason       String?          @map("unlink_reason") @db.LongText
  createdAt          DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  createdById        String           @map("created_by_id") @db.Char(36)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  updatedById        String           @map("updated_by_id") @db.Char(36)
  rowVersion         Int              @default(1) @map("row_version") @db.UnsignedInt
  createdBy          User             @relation("R_OwnerSubject_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_owner_subjects_created_by")
  updatedBy          User             @relation("R_OwnerSubject_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_owner_subjects_updated_by")
  owner              Owner            @relation("R_OwnerSubject_owner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_owner_subjects_owner")
  legalSubject       LegalSubject     @relation("R_OwnerSubject_legalSubject", fields: [legalSubjectId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_owner_subjects_legal_subject")
  source             SourceReference? @relation("R_OwnerSubject_source", fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_owner_subjects_source")
  route_ownerSubject Route[]          @relation("R_Route_ownerSubject")

  @@unique([ownerId, legalSubjectId], map: "owner_subjects_owner_id_legal_subject_id_key")
  @@index([legalSubjectId, linkState], map: "owner_subjects_legal_subject_id_link_state_idx")
  @@map("owner_subjects")
}

/// Person in an agency capacity. No signature blob, adoption, or send endpoint.
model Signer {
  id                            String                   @id @default(uuid()) @map("id") @db.Char(36)
  agencyId                      String                   @map("agency_id") @db.Char(36)
  fullLegalName                 String                   @map("full_legal_name") @db.VarChar(255)
  title                         String?                  @map("title") @db.VarChar(200)
  contactEmail                  String?                  @map("contact_email") @db.VarChar(254)
  identitySourceId              String?                  @map("identity_source_id") @db.Char(36)
  delegationSourceId            String?                  @map("delegation_source_id") @db.Char(36)
  operationalState              SignerState              @default(DRAFT) @map("operational_state")
  canonicalCode                 String?                  @unique @map("canonical_code") @db.VarChar(100)
  canonicalSourceId             String?                  @map("canonical_source_id") @db.Char(36)
  bindingState                  BindingState             @default(LOCAL_ONLY) @map("binding_state")
  notes                         String?                  @map("notes") @db.LongText
  archivedAt                    DateTime?                @map("archived_at") @db.DateTime(3)
  archiveReason                 String?                  @map("archive_reason") @db.LongText
  createdAt                     DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  createdById                   String                   @map("created_by_id") @db.Char(36)
  updatedAt                     DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)
  updatedById                   String                   @map("updated_by_id") @db.Char(36)
  rowVersion                    Int                      @default(1) @map("row_version") @db.UnsignedInt
  createdBy                     User                     @relation("R_Signer_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_signers_created_by")
  updatedBy                     User                     @relation("R_Signer_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_signers_updated_by")
  agency                        Agency                   @relation("R_Signer_agency", fields: [agencyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_signers_agency")
  identitySource                SourceReference?         @relation("R_Signer_identitySource", fields: [identitySourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_signers_identity_source")
  delegationSource              SourceReference?         @relation("R_Signer_delegationSource", fields: [delegationSourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_signers_delegation_source")
  canonicalSource               SourceReference?         @relation("R_Signer_canonicalSource", fields: [canonicalSourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_signers_canonical_source")
  route_defaultSigner           Route[]                  @relation("R_Route_defaultSigner")
  coverageSigner_signer         CoverageSigner[]         @relation("R_CoverageSigner_signer")
  caseAuthoritySelection_signer CaseAuthoritySelection[] @relation("R_CaseAuthoritySelection_signer")

  @@unique([id, agencyId], map: "signers_id_agency_id_key")
  @@index([agencyId, operationalState], map: "signers_agency_id_operational_state_idx")
  @@map("signers")
}

/// 
model Route {
  id                           String                   @id @default(uuid()) @map("id") @db.Char(36)
  agencyId                     String                   @map("agency_id") @db.Char(36)
  ownerSubjectId               String                   @map("owner_subject_id") @db.Char(36)
  platform                     Platform                 @default(YOUTUBE) @map("platform")
  linkState                    LinkState                @default(LINKED) @map("link_state")
  defaultSignerId              String?                  @map("default_signer_id") @db.Char(36)
  preferredCoverageId          String?                  @map("preferred_coverage_id") @db.Char(36)
  casePrefixHint               String?                  @map("case_prefix_hint") @db.VarChar(40)
  unlinkedAt                   DateTime?                @map("unlinked_at") @db.DateTime(3)
  stateReason                  String?                  @map("state_reason") @db.LongText
  canonicalCode                String?                  @unique @map("canonical_code") @db.VarChar(100)
  canonicalSourceId            String?                  @map("canonical_source_id") @db.Char(36)
  bindingState                 BindingState             @default(LOCAL_ONLY) @map("binding_state")
  notes                        String?                  @map("notes") @db.LongText
  archivedAt                   DateTime?                @map("archived_at") @db.DateTime(3)
  archiveReason                String?                  @map("archive_reason") @db.LongText
  createdAt                    DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  createdById                  String                   @map("created_by_id") @db.Char(36)
  updatedAt                    DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)
