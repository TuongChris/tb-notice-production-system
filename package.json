{
  "name": "tb-notice-production-system",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/contracts"
  ],
  "scripts": {
    "env:init": "node scripts/local/create-env.mjs",
    "db:up": "docker compose up -d --wait mysql",
    "db:down": "docker compose stop mysql",
    "db:format": "node scripts/db/prisma-guarded.mjs format",
    "db:validate": "node scripts/db/prisma-guarded.mjs validate",
    "db:generate": "node scripts/db/prisma-guarded.mjs generate",
    "db:migrate:create": "node scripts/db/prisma-guarded.mjs migrate-create",
    "db:compare:preview": "node scripts/db/sql-semantic-compare.mjs docs/reference/database-api-v1/TB_DATABASE_SCHEMA_API_CONTRACT_v1/prisma/initial-schema.preview.sql apps/api/prisma/migrations/20260923103912_initial_schema/migration.sql",
    "db:status": "node scripts/db/prisma-guarded.mjs status",
    "db:migrate:deploy": "node scripts/db/prisma-guarded.mjs deploy",
    "db:verify": "node scripts/db/verify-metadata.mjs",
    "db:seed": "node scripts/db/seed.mjs",
    "admin:create": "node scripts/admin/admin.ts create",
    "admin:password": "node scripts/admin/admin.ts password",
    "admin:disable": "node scripts/admin/admin.ts disable",
    "admin:enable": "node scripts/admin/admin.ts enable",
    "admin:revoke-sessions": "node scripts/admin/admin.ts revoke-sessions",
    "db:drift:diff-migrations": "node scripts/db/prisma-guarded.mjs diff-migrations-to-schema",
    "db:drift:diff-datasource": "node scripts/db/prisma-guarded.mjs diff-datasource-to-schema",
    "db:drift:probe": "node scripts/db/prisma-guarded.mjs drift-probe",
    "db:introspect": "node scripts/db/prisma-guarded.mjs introspect-print",
    "test:db": "yarn db:generate && yarn workspace @tb/contracts run build && node scripts/db/run-db-tests.mjs",
    "contracts:generate": "yarn workspace @tb/contracts run build && node scripts/contracts/generate.ts",
    "contracts:check": "yarn workspace @tb/contracts run build && node scripts/contracts/check.ts",
    "reference:check": "node scripts/reference/check.ts",
    "reference:helper-tests": "node scripts/reference/run-helper-tests.ts",
    "test": "yarn workspace @tb/contracts run build && vitest run --config vitest.config.ts",
    "test:contracts": "yarn test",
    "test:transition-baseline": "vitest run --config vitest.transition.config.ts",
    "build": "yarn db:generate && yarn workspace @tb/contracts run build && yarn workspace @tb/api run build && yarn workspace @tb/web run build",
    "typecheck": "yarn db:generate && yarn workspace @tb/contracts run build && yarn workspace @tb/contracts run typecheck && yarn workspace @tb/api run typecheck && yarn workspace @tb/web run typecheck && tsc -p tests/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && tsc -p tests/web/tsconfig.json --noEmit",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "dev": "node scripts/local/dev.ts",
    "dev:verify-shutdown": "node scripts/local/verify-dev-shutdown.ts",
    "smoke:local": "node scripts/local/smoke.ts",
    "smoke:auth": "node scripts/local/auth-smoke.ts",
    "smoke:directory": "node scripts/local/directory-smoke.ts",
    "smoke:p3a": "node scripts/local/p3a-smoke.ts",
    "smoke:p3b": "node scripts/local/p3b-smoke.ts",
    "ui:sandbox": "node scripts/local/ui-sandbox.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "happy-dom": "20.14.5",
    "mariadb": "3.4.5",
    "oxlint": "1.85.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
