{
  "name": "tb-notice-production-system",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/contracts"
  ],
  "scripts": {
    "env:init": "node scripts/local/create-env.mjs",
    "db:up": "docker compose up -d --wait mysql",
    "db:down": "docker compose stop mysql",
    "db:format": "node scripts/db/prisma-guarded.mjs format",
    "db:validate": "node scripts/db/prisma-guarded.mjs validate",
    "db:generate": "node scripts/db/prisma-guarded.mjs generate",
    "db:migrate:create": "node scripts/db/prisma-guarded.mjs migrate-create",
    "build": "yarn workspace @tb/contracts run build && yarn workspace @tb/api run build && yarn workspace @tb/web run build",
    "typecheck": "yarn workspace @tb/contracts run build && yarn workspaces foreach --all --topological run typecheck",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "dev": "yarn workspace @tb/contracts run build && yarn workspaces foreach --all --parallel --interlaced --include @tb/api --include @tb/web run dev"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "oxlint": "1.85.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  }
}
