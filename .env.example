# Local-only configuration template (TECHNOLOGY_ARCHITECTURE §7, decision D3).
# Create the real root .env with `yarn env:init` (random local passwords, never printed).
# Never commit .env. Never use production credentials. The application never uses root.

# Docker MySQL 8.4 initialization secrets (container-internal; root is init-only).
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LOCAL_RANDOM
TB_DB_APP_PASSWORD=REPLACE_WITH_LOCAL_RANDOM
TB_DB_MIGRATE_PASSWORD=REPLACE_WITH_LOCAL_RANDOM

# Runtime: tb_dev, DML only, tb_notice_dev only.
DATABASE_URL="mysql://tb_dev:REPLACE_WITH_TB_DB_APP_PASSWORD@127.0.0.1:3307/tb_notice_dev"
# Migration/test tooling: tb_migrate, limited to the four allowlisted schemas.
MIGRATION_DATABASE_URL="mysql://tb_migrate:REPLACE_WITH_TB_DB_MIGRATE_PASSWORD@127.0.0.1:3307/tb_notice_dev"
SHADOW_DATABASE_URL="mysql://tb_migrate:REPLACE_WITH_TB_DB_MIGRATE_PASSWORD@127.0.0.1:3307/tb_notice_shadow"
TEST_DATABASE_URL="mysql://tb_migrate:REPLACE_WITH_TB_DB_MIGRATE_PASSWORD@127.0.0.1:3307/tb_notice_test"
REPLAY_DATABASE_URL="mysql://tb_migrate:REPLACE_WITH_TB_DB_MIGRATE_PASSWORD@127.0.0.1:3307/tb_notice_replay"

# P1 authentication (API_CONTRACT_v1 §3). `yarn env:init` generates the secret locally (never printed,
# never committed); the placeholder below is rejected by the API on purpose.
# HMAC key for session-bound CSRF tokens: base64url text of 32 random bytes.
TB_SESSION_SECRET=REPLACE_WITH_yarn_env:init_GENERATED_VALUE
# Exact browser origins allowed for unsafe API requests: loopback HTTP origins only, comma-separated.
# Canonical Windows-browser origin: http://localhost:5173; WSL tools may use http://127.0.0.1:5173.
# The session cookie is host-only: each hostname has its own sessions, they are never shared.
TB_ALLOWED_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
