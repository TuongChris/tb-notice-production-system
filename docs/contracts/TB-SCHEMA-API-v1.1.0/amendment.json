    "added": {
      "CaseAuthoritySelectionView": {
        "type": "object",
        "properties": {
          "selection": {
            "$ref": "#/$defs/CaseAuthoritySelection"
          },
          "coverages": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/CaseAuthorityCoverage"
            },
            "minItems": 1,
            "maxItems": 20
          }
