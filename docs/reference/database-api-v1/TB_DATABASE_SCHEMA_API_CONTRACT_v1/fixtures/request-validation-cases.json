[
  {
    "name": "Agency can begin with displayName",
    "schema": "CreateAgency",
    "expectedValid": true,
    "payload": {
      "displayName": "TEST Agency A"
    }
  },
  {
    "name": "Agency does not require fabricated legalName",
    "schema": "CreateAgency",
    "expectedValid": true,
    "payload": {
      "displayName": "TEST A",
      "legalName": null
    }
  },
  {
    "name": "Agency rejects unknown ownership flag",
    "schema": "CreateAgency",
    "expectedValid": false,
    "payload": {
      "displayName": "TEST A",
      "ownsAllWorks": true
    }
  },
  {
    "name": "Agency empty name rejected",
    "schema": "CreateAgency",
    "expectedValid": false,
    "payload": {
      "displayName": ""
    }
  },
  {
    "name": "Empty PATCH rejected",
    "schema": "PatchAgency",
    "expectedValid": false,
    "payload": {}
  },
  {
    "name": "Explicit null clears nullable field",
    "schema": "PatchAgency",
    "expectedValid": true,
    "payload": {
      "legalName": null
    }
  },
  {
    "name": "Route needs legal subject association",
