  recordState RecordState @default(DRAFT) @map("record_state")
  canonicalCode String? @unique @db.VarChar(100) @map("canonical_code")
  canonicalSourceId String? @db.Char(36) @map("canonical_source_id")
  bindingState BindingState @default(LOCAL_ONLY) @map("binding_state")
  notes String? @db.LongText @map("notes")
  archivedAt DateTime? @db.DateTime(3) @map("archived_at")
  archiveReason String? @db.LongText @map("archive_reason")
  createdAt DateTime @default(now()) @db.DateTime(3) @map("created_at")
  createdById String @db.Char(36) @map("created_by_id")
  updatedAt DateTime @updatedAt @db.DateTime(3) @map("updated_at")
  updatedById String @db.Char(36) @map("updated_by_id")
  rowVersion Int @default(1) @db.UnsignedInt @map("row_version")
  createdBy User @relation("R_Owner_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_owners_created_by")
  updatedBy User @relation("R_Owner_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_owners_updated_by")
  canonicalSource SourceReference? @relation("R_Owner_canonicalSource", fields: [canonicalSourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_owners_canonical_source")
  ownerSubject_owner OwnerSubject[] @relation("R_OwnerSubject_owner")
  caseRecord_ownerHint CaseRecord[] @relation("R_CaseRecord_ownerHint")
  @@index([recordState, createdAt], map: "owners_record_state_created_at_idx")
  @@map("owners")
}

/// Exact person or legal entity. Names/registration are matching hints, not automatic global deduplication.
model LegalSubject {
  id String @id @default(uuid()) @db.Char(36) @map("id")
  subjectType SubjectType @map("subject_type")
  legalName String @db.VarChar(255) @map("legal_name")
  aliases Json? @map("aliases")
  jurisdictionCountry String? @db.VarChar(2) @map("jurisdiction_country")
  legalForm String? @db.VarChar(80) @map("legal_form")
  registrationAuthority String? @db.VarChar(200) @map("registration_authority")
  registrationNumber String? @db.VarChar(100) @map("registration_number")
  contactEmail String? @db.VarChar(254) @map("contact_email")
  postalAddress Json? @map("postal_address")
  fieldAttributions Json? @map("field_attributions")
  identityReviewState ReviewState @default(UNREVIEWED) @map("identity_review_state")
  recordState RecordState @default(DRAFT) @map("record_state")
  canonicalCode String? @unique @db.VarChar(100) @map("canonical_code")
  canonicalSourceId String? @db.Char(36) @map("canonical_source_id")
  bindingState BindingState @default(LOCAL_ONLY) @map("binding_state")
  notes String? @db.LongText @map("notes")
  archivedAt DateTime? @db.DateTime(3) @map("archived_at")
  archiveReason String? @db.LongText @map("archive_reason")
  createdAt DateTime @default(now()) @db.DateTime(3) @map("created_at")
  createdById String @db.Char(36) @map("created_by_id")
  updatedAt DateTime @updatedAt @db.DateTime(3) @map("updated_at")
  updatedById String @db.Char(36) @map("updated_by_id")
  rowVersion Int @default(1) @db.UnsignedInt @map("row_version")
  createdBy User @relation("R_LegalSubject_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_legal_subjects_created_by")
  updatedBy User @relation("R_LegalSubject_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_legal_subjects_updated_by")
  canonicalSource SourceReference? @relation("R_LegalSubject_canonicalSource", fields: [canonicalSourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_legal_subjects_canonical_source")
  ownerSubject_legalSubject OwnerSubject[] @relation("R_OwnerSubject_legalSubject")
  @@index([legalName], map: "legal_subjects_legal_name_idx")
  @@index([registrationAuthority, registrationNumber], map: "legal_subjects_registration_authority_registrati_902c1ede")
  @@map("legal_subjects")
}

