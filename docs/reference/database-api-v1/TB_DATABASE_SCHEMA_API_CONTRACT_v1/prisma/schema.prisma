// TB-SCHEMA-API-v1.0.0 — proposed implementation schema. NOT migrated.
// Read docs/DATABASE_SCHEMA_v1.md and docs/INVARIANTS.md before implementation.
generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}
datasource db {
  provider = "mysql"
  relationMode = "foreignKeys"
}

enum BindingState {
  LOCAL_ONLY
  SOURCE_REFERENCED
  DIVERGENT
}

enum RecordState {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SubjectType {
  INDIVIDUAL
  LEGAL_ENTITY
  OTHER
}

enum Platform {
  YOUTUBE
}

enum LinkState {
  LINKED
  PAUSED
  UNLINKED
}

enum SignerState {
  DRAFT
  AVAILABLE
  PAUSED
  ENDED
}

enum VersionState {
  DRAFT
  FROZEN
}

enum ChangeKind {
  NEW_AUTHORIZATION
  AMENDMENT
  DOCUMENT_CAPTURE
  METADATA_CORRECTION
}

enum ValidityModel {
  UNKNOWN
  FIXED_TERM
  UNTIL_TERMINATED
}

enum DocumentState {
  MISSING
  DRAFT
  SIGNED_APPEARING
  UNKNOWN
}

enum ReviewState {
  UNREVIEWED
  REVIEWED_WITH_LIMITS
  CONFLICT
}

enum CoverageState {
  PROPOSED
  RECORDED
  SUSPENDED
  ENDED
}

enum Exclusivity {
  UNKNOWN
  EXCLUSIVE
  NON_EXCLUSIVE
}

enum AuthorityEventType {
  CURRENTNESS_RECORDED
  REVOCATION
  TERMINATION
  SUPERSESSION
  RESIGNATION
  CORRECTION
}

enum Provenance {
  DOCUMENT_REVIEWED
  OPERATOR_REPORTED
  ANALYSIS
  MISSING
  CONFLICT
}

enum CaseClass {
  WORKING_INTAKE
  CURRENT_OPERATION
  RECOVERED_HISTORY
  EXTERNAL_REFERENCE
}

enum WorkflowState {
  INTAKE
  PREPARING
  DRAFTING
  AWAITING_HUMAN
  AWAITING_PLATFORM
  CLOSED
}

enum TaskType {
  INITIAL
  NMI_REPLY
}

enum GenerationMode {
  PREPARATION
  DRAFTING
}

enum SourceRole {
  CANONICAL_RECORD
  PRIMARY_CORRESPONDENCE
  OPERATOR_INPUT
  DERIVED_DRAFT
  EXTERNAL_REFERENCE
  POLICY_REFERENCE
}

enum AccessState {
  NOT_CHECKED
  ACCESSIBLE_AT_CHECK
  UNAVAILABLE_AT_CHECK
}

enum HashTarget {
  RAW_FILE
  EXTRACTED_TEXT
  OTHER
}

enum FactType {
  RIGHTS_BASIS
  RIGHTS_SCOPE
  PERMISSION
  AV_COMPARISON
  EXCEPTION_REVIEW
  WORK_IDENTIFICATION
  REPORTED_IDENTIFICATION
  DUPLICATE_REVIEW
  AUTHORITY_CURRENTNESS
}

enum FactScope {
  CASE
  WORK
  REPORTED_ITEM
  USE
}

enum ResolutionState {
  UNASSESSED
  SUPPORTED_FOR_SCOPE
  CONFLICT
  WITHDRAWN
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum CaptureMode {
  RAW_SOURCE
  COPIED_FULL_TEXT
  EXCERPT
  OPERATOR_REPORTED
}

enum BodyRole {
  FULL_MESSAGE
  AUTHORED_BODY
  QUOTED_HISTORY
  EXCERPT
  UNKNOWN
}

enum EventType {
  INITIAL_AS_SENT
  ACK
  NMI
  REPLY_AS_SENT
  SUPPLEMENT_AS_SENT
  CORRECTION_AS_SENT
  OUTCOME
  OTHER
}

enum Outcome {
  REMOVED
  REINSTATED
  REJECTED
  RETRACTED
  OTHER
}

enum TechnicalResult {
  TECHNICAL_PASS
  BLOCKED
  REVIEW_REQUIRED
  ERROR
}

enum IssueSeverity {
  BLOCKER
  REVIEW_REQUIRED
  WARNING
  INFO
}

enum CheckKind {
  DETERMINISTIC
  HEURISTIC
}

enum GateId {
  G1
  G2
  G3
  G4
  G5
  G6
}

enum GateResult {
  PASS
  HOLD
  BLOCKED
  MISSING
  CONFLICT
}

enum PerformerKind {
  HUMAN
  AI_ASSISTED
  DOCUMENTED_EXTERNAL_REVIEW
}

enum AssessmentScopeState {
  RECORDED_NOT_ADOPTED
  SCOPE_CONFIRMED_FOR_CANDIDATE
}

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED
}

/// App operator, never automatically a signer. Bootstrap via local CLI, no public user creation API.
model User {
