/// Same actor + operation + key + payload replays same response; failed tx leaves no committed result. Expiry is bounded replay horizon, not permanent deduplication.
model IdempotencyRecord {
  id String @id @default(uuid()) @db.Char(36) @map("id")
  actorUserId String @db.Char(36) @map("actor_user_id")
  operationId String @db.VarChar(100) @map("operation_id")
  idempotencyKey String @db.VarChar(100) @map("idempotency_key")
  requestSha256 String @db.VarChar(64) @map("request_sha256")
  state IdempotencyState @map("state")
  responseStatus Int? @db.UnsignedSmallInt @map("response_status")
  responseJson Json? @map("response_json")
  resourceType String? @db.VarChar(100) @map("resource_type")
  resourceId String? @db.Char(36) @map("resource_id")
  expiresAt DateTime @db.DateTime(3) @map("expires_at")
  createdAt DateTime @default(now()) @db.DateTime(3) @map("created_at")
  actor User @relation("R_IdempotencyRecord_actor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_idempotency_records_actor")
  @@unique([actorUserId, operationId, idempotencyKey], map: "idempotency_records_actor_user_id_operation_id_i_92ad1804")
  @@index([expiresAt], map: "idempotency_records_expires_at_idx")
  @@map("idempotency_records")
}
