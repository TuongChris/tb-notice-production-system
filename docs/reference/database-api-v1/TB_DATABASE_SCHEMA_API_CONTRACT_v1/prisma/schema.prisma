/// Store only hashes, never raw browser tokens.
model AuthSession {
  id String @id @default(uuid()) @db.Char(36) @map("id")
  userId String @db.Char(36) @map("user_id")
  tokenHash String @unique @db.VarChar(64) @map("token_hash")
  csrfTokenHash String @db.VarChar(64) @map("csrf_token_hash")
  expiresAt DateTime @db.DateTime(3) @map("expires_at")
  lastSeenAt DateTime @db.DateTime(3) @map("last_seen_at")
  revokedAt DateTime? @db.DateTime(3) @map("revoked_at")
  createdAt DateTime @default(now()) @db.DateTime(3) @map("created_at")
  user User @relation("R_AuthSession_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_auth_sessions_user")
  @@index([userId, expiresAt], map: "auth_sessions_user_id_expires_at_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

/// Directory/configuration state is not legal authority. fieldAttributions has schema and source checks in service.
model Agency {
  id String @id @default(uuid()) @db.Char(36) @map("id")
  displayName String @db.VarChar(200) @map("display_name")
  legalName String? @db.VarChar(255) @map("legal_name")
  organizationType String? @db.VarChar(50) @map("organization_type")
  jurisdictionCountry String? @db.VarChar(2) @map("jurisdiction_country")
  registrationAuthority String? @db.VarChar(200) @map("registration_authority")
  registrationNumber String? @db.VarChar(100) @map("registration_number")
  websiteUrl String? @db.VarChar(2048) @map("website_url")
  copyrightEmail String? @db.VarChar(254) @map("copyright_email")
  verificationEmail String? @db.VarChar(254) @map("verification_email")
  postalAddress Json? @map("postal_address")
  phone String? @db.VarChar(80) @map("phone")
  driveRootUrl String? @db.VarChar(2048) @map("drive_root_url")
  masterUrl String? @db.VarChar(2048) @map("master_url")
  startHereUrl String? @db.VarChar(2048) @map("start_here_url")
  fieldAttributions Json? @map("field_attributions")
  recordState RecordState @default(DRAFT) @map("record_state")
  canonicalCode String? @unique @db.VarChar(100) @map("canonical_code")
  canonicalSourceId String? @db.Char(36) @map("canonical_source_id")
  bindingState BindingState @default(LOCAL_ONLY) @map("binding_state")
  notes String? @db.LongText @map("notes")
  archivedAt DateTime? @db.DateTime(3) @map("archived_at")
  archiveReason String? @db.LongText @map("archive_reason")
  createdAt DateTime @default(now()) @db.DateTime(3) @map("created_at")
  createdById String @db.Char(36) @map("created_by_id")
  updatedAt DateTime @updatedAt @db.DateTime(3) @map("updated_at")
  updatedById String @db.Char(36) @map("updated_by_id")
  rowVersion Int @default(1) @db.UnsignedInt @map("row_version")
  createdBy User @relation("R_Agency_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_agencies_created_by")
  updatedBy User @relation("R_Agency_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_agencies_updated_by")
  canonicalSource SourceReference? @relation("R_Agency_canonicalSource", fields: [canonicalSourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_agencies_canonical_source")
  signer_agency Signer[] @relation("R_Signer_agency")
  route_agency Route[] @relation("R_Route_agency")
  mandate_agency Mandate[] @relation("R_Mandate_agency")
  caseRecord_agency CaseRecord[] @relation("R_CaseRecord_agency")
  sourceReference_agency SourceReference[] @relation("R_SourceReference_agency")
  correspondence_agency Correspondence[] @relation("R_Correspondence_agency")
  @@index([recordState, createdAt], map: "agencies_record_state_created_at_idx")
  @@map("agencies")
}

/// Client namespace, not proof of work ownership.
