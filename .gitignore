# TB Notice Production System — root ignore policy (AR-016, Repository Blueprint §4).
# Created before any package installation. Ignore rules do not remove already-tracked
# files; review every staged diff before committing.

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Dependencies and Yarn local state (lockfile stays tracked)
node_modules/
.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/patches
!.yarn/sdks
!.yarn/versions
.yarn/install-state.gz
.pnp.*

# Build and runtime artifacts
dist/
build/
out/
coverage/
*.tsbuildinfo
.vite/
.cache/
tmp/
*.tmp

# Runtime-generated Prisma client (regenerated locally; never committed)
apps/api/generated/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local database material: dumps, exports, Docker data
*.sql.dump
*.sql.gz
*.dump
*.bak
docker-data/
mysql-data/

# Raw mail / evidence must never enter Git
*.eml
*.msg
*.mbox

# Local AI assistant auth/session state
.claude/
.claude.json
CLAUDE.local.md

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db
